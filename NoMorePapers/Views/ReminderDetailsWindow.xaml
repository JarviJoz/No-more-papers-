<Window x:Class="NoMorePapers.Views.ReminderDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Detalles del recordatorio"
        Width="430" Height="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">
    <Border Background="{StaticResource SurfaceBrush}" Padding="24" CornerRadius="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <TextBlock Text="DETALLES DEL RECORDATORIO" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                <Button Click="CloseButton_Click" HorizontalAlignment="Right" Style="{StaticResource MaterialDesignIconButton}" ToolTip="Cerrar">
                    <materialDesign:PackIcon Kind="Close" />
                </Button>
            </Grid>
            <ScrollViewer Grid.Row="1" Margin="0,22,0,18" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Título / caso" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,16" />
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Fecha" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding ScheduledAt, StringFormat='{}{0:dd/MM/yyyy}'}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Hora" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding ScheduledAt, StringFormat='{}{0:HH:mm}'}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Descripción" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    <Border Background="#FFF8F8F8" CornerRadius="8" Padding="10" Margin="0,3,0,16">
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" MinHeight="55" />
                    </Border>
                    <TextBlock Text="Notificaciones" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding NotificationsEnabled, StringFormat='Activadas: {0}'}" FontWeight="SemiBold" Margin="0,3,0,12" />
                    <TextBlock Text="Repetición" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding Recurrence}" FontWeight="SemiBold" Margin="0,3,0,12" />
                    <TextBlock Text="Anticipación" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding NotificationAdvanceMinutes, StringFormat='{}{0} minutos antes'}" FontWeight="SemiBold" Margin="0,3,0,12" />
                    <TextBlock Text="Sonido activado" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding SoundEnabled}" FontWeight="SemiBold" />
                </StackPanel>
            </ScrollViewer>
            <Button x:Name="DeleteButton" Grid.Row="2" Content="ELIMINAR" Click="DeleteButton_Click" HorizontalAlignment="Right" Width="150" Height="48" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" Style="{StaticResource MaterialDesignFlatButton}" />
        </Grid>
    </Border>
</Window>
