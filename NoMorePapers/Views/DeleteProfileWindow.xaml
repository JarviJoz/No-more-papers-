<Window x:Class="NoMorePapers.Views.DeleteProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="28" Width="520">
        <StackPanel>
            <Grid>
                <TextBlock Text="¿Estás seguro de que deseas eliminar tu perfil?" Foreground="{StaticResource TextPrimaryBrush}" FontSize="19" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,30,0" />
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Width="28" Height="28" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}" Click="CancelClick" AutomationProperties.Name="Cerrar confirmación" />
            </Grid>
            <TextBlock Text="Esta acción es permanente y no se puede deshacer." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" Margin="0,12,0,16" />
            <TextBlock x:Name="PasswordPrompt" Text="Este perfil está protegido. Introduce la contraseña para confirmar." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,7" Visibility="Collapsed" />
            <PasswordBox x:Name="ConfirmationPassword" MinHeight="38" Padding="9" Margin="0,0,0,18" Visibility="Collapsed" AutomationProperties.Name="Contraseña del perfil" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Click="CancelClick" MinWidth="110" Height="40" Margin="0,0,10,0" Padding="12,5" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}" BorderBrush="{StaticResource BorderBrush}" />
                <Button Content="Sí, eliminar perfil" Click="ConfirmClick" MinWidth="150" Height="40" Padding="12,5" Background="{StaticResource DangerBrush}" Foreground="White" BorderThickness="0" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
