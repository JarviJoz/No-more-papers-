<UserControl x:Class="NoMorePapers.Views.WorkspaceView" x:Name="WorkspaceViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:NoMorePapers.Views"
             Background="{DynamicResource AppBackgroundBrush}"
             Loaded="WorkspaceView_Loaded">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:CategoryDisplayConverter x:Key="CategoryDisplayConverter" />
        <Style x:Key="CollapsibleSidebarButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="Padding" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SelectedSidebarButtonStyle" TargetType="Button" BasedOn="{StaticResource CollapsibleSidebarButtonStyle}">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsActiveCasesMode}" Value="True" />
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Active" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsArchivedMode}" Value="True" />
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Archived" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsTrashMode}" Value="True" />
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Trash" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidebarToggleButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
            <Setter Property="BorderBrush" Value="#3D568A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="Padding" Value="0" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidebarNavigationIconStyle" TargetType="{x:Type materialDesign:PackIcon}">
            <Setter Property="Margin" Value="0,0,12,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                    <Setter Property="Margin" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="SidebarBorder" Grid.Column="0" Grid.RowSpan="5" Width="218" Background="{DynamicResource SidebarBrush}">
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Margin" Value="18,24,18,20" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                                <Setter Property="Margin" Value="6,24,6,20" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel x:Name="SidebarBrand" Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,34">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="HorizontalAlignment" Value="Left" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="10" Width="38" Height="42">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Margin" Value="0,0,10,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                                        <Setter Property="Margin" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <materialDesign:PackIcon Kind="FolderMultipleOutline" Width="25" Height="25" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="NO MORE" FontSize="15" FontWeight="Bold" Foreground="#F3F4F6" />
                        <TextBlock Text="PAPERS" FontSize="21" FontWeight="ExtraBold" Foreground="#F3F4F6" Margin="0,-5,0,0" />
                    </StackPanel>
                    <TextBlock Text="v1.8" FontSize="10" Foreground="#D1D5DB" VerticalAlignment="Top" Margin="6,4,0,0"
                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="ESPACIO DE TRABAJO" FontSize="10" FontWeight="Bold" Foreground="#D1D5DB" Margin="12,0,0,8"
                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Click="ToggleSidebar_Click" Style="{StaticResource SidebarToggleButtonStyle}"
                            ToolTip="{Binding SidebarToggleToolTip}" AutomationProperties.Name="{Binding SidebarToggleToolTip}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Width="19" Height="19">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="{x:Type materialDesign:PackIcon}" BasedOn="{StaticResource SidebarNavigationIconStyle}">
                                        <Setter Property="Kind" Value="ChevronLeft" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                                                <Setter Property="Kind" Value="ChevronRight" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                            <TextBlock Text="{Binding SidebarToggleToolTip}" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShowActiveCasesCommand}" Tag="Active" Style="{StaticResource SelectedSidebarButtonStyle}" ToolTip="Casos activos">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="FolderMultipleOutline" Width="19" Height="19" Style="{StaticResource SidebarNavigationIconStyle}" /><TextBlock Text="Casos activos" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" /></StackPanel>
                    </Button>
                    <Button Command="{Binding OpenStudentsCommand}" Style="{StaticResource CollapsibleSidebarButtonStyle}" ToolTip="Estudiantes">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="AccountGroup" Width="19" Height="19" Style="{StaticResource SidebarNavigationIconStyle}" /><TextBlock Text="Estudiantes" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" /></StackPanel>
                    </Button>
                    <Button Command="{Binding ShowStatisticsCommand}" Style="{StaticResource CollapsibleSidebarButtonStyle}" ToolTip="Estadísticas">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ChartPie" Width="19" Height="19" Style="{StaticResource SidebarNavigationIconStyle}" /><TextBlock Text="Estadísticas" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" /></StackPanel>
                    </Button>
                    <Button Command="{Binding ToggleCalendarCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource CollapsibleSidebarButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCalendarMode}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsCalendarMode}" Value="True" />
                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="CalendarClock" Width="19" Height="19" Style="{StaticResource SidebarNavigationIconStyle}" /><TextBlock Text="Programador" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" /></StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Separator Background="#4B5563" Margin="8,15" />
                    <Button Command="{Binding ShowActiveCasesCommand}" Tag="Active" Style="{StaticResource SelectedSidebarButtonStyle}" ToolTip="Mi espacio">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="HomeOutline" Width="19" Height="19" Style="{StaticResource SidebarNavigationIconStyle}" /><TextBlock Text="Mi espacio" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" /></StackPanel>
                    </Button>
                    <Button Command="{Binding ShowArchivedCasesCommand}" Tag="Archived" Style="{StaticResource SelectedSidebarButtonStyle}" ToolTip="Archivados">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Archive" Width="19" Height="19" Style="{StaticResource SidebarNavigationIconStyle}" /><TextBlock Text="Archivados" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" /></StackPanel>
                    </Button>
                    <Button Command="{Binding ShowTrashCasesCommand}" Tag="Trash" Style="{StaticResource SelectedSidebarButtonStyle}" ToolTip="Basurero">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ArrowDownBox" Width="19" Height="19" Style="{StaticResource SidebarNavigationIconStyle}" /><TextBlock Text="Basurero" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" /></StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="8,20,0,0" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <materialDesign:PackIcon Kind="Send" Width="22" Height="22" Foreground="#F3F4F6" Margin="0,0,0,12" />
                    <TextBlock Text="Menos papeles," Foreground="#D1D5DB" FontSize="12" />
                    <TextBlock Text="más tiempo" Foreground="#D1D5DB" FontSize="12" />
                    <TextBlock Text="para lo importante." Foreground="#D1D5DB" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- TOOL BAR SUPERIOR -->
        <Grid Grid.Row="0" Grid.Column="1" Margin="22,14,22,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="390" Height="44" Background="White" BorderThickness="1"
                    CornerRadius="12" Padding="12,0" VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                        <Style.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="Magnify" Width="20" Height="20" Foreground="{StaticResource PrimaryDarkBrush}"
                                             VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Buscar estudiante, grado o categoría..."
                             Background="Transparent" BorderThickness="0" Padding="2,8" VerticalContentAlignment="Center"
                             FontSize="13" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Command="{Binding OpenNotificationsCommand}" Style="{StaticResource MaterialDesignIconButton}" ToolTip="Notificaciones" Margin="0,0,8,0">
                    <Grid>
                        <materialDesign:PackIcon Kind="BellOutline" />
                         <Border Background="{StaticResource DangerBrush}" CornerRadius="9" MinWidth="18" Height="18"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" Padding="4,0"
                                 Visibility="{Binding HasNewNotifications, Converter={StaticResource BooleanToVisibilityConverter}}">
                             <TextBlock Text="{Binding UnreadNotificationCount}" Foreground="White" FontSize="10" FontWeight="Bold"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                         </Border>
                    </Grid>
                </Button>
                <Border CornerRadius="18" Padding="12,8" Margin="0,0,10,0" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="AccountOutline" Width="19" Height="19" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding CurrentProfile.Name}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Configuración" AutomationProperties.Name="Abrir configuración" Click="SettingsButton_Click">
                    <materialDesign:PackIcon Kind="CogOutline" />
                </Button>
                <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Información" AutomationProperties.Name="Acerca de No More Papers" Click="AboutButton_Click">
                    <materialDesign:PackIcon Kind="InformationOutline" />
                </Button>
                <Button Command="{Binding LogoutCommand}" Style="{StaticResource MaterialDesignIconButton}" ToolTip="Cerrar Sesión" Foreground="{StaticResource DangerBrush}">
                    <materialDesign:PackIcon Kind="Logout"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- TÍTULO DEL MODO ACTUAL (Activos, Archivados o Papelera) -->
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource AppCardStyle}" Margin="22,0,22,14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Width="60" Height="60" CornerRadius="14"
                    Background="{DynamicResource SurfaceMutedBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Visibility="{Binding IsActiveCasesMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <materialDesign:PackIcon Kind="FolderMultipleOutline" Width="34" Height="34" Foreground="{DynamicResource PrimaryTextBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

                <Border Grid.Row="0" Grid.Column="0" Width="60" Height="60" CornerRadius="14"
                    Background="{DynamicResource SurfaceMutedBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Visibility="{Binding IsCalendarMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <materialDesign:PackIcon Kind="CalendarClock" Width="34" Height="34" Foreground="{DynamicResource PrimaryTextBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0"
                        Visibility="{Binding IsActiveCasesMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="CASOS ACTIVOS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="Gestión de Casos" FontSize="25" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Aquí puedes ver y administrar todos los casos que están en proceso."
                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0"
                        Visibility="{Binding IsCalendarMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Programador" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
            </StackPanel>

            <Border Grid.Row="0" Grid.Column="1" Background="{Binding ModeHeaderBrush}" CornerRadius="10" Padding="12,8" VerticalAlignment="Center"
                    Visibility="{Binding ShowBackToActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel>
                    <Button Command="{Binding ShowActiveCasesCommand}"
                            Visibility="{Binding ShowBackToActive, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Style="{StaticResource MaterialDesignIconButton}" ToolTip="Volver a Casos Activos"
                            Width="28" Height="28" Padding="0" Margin="0,0,6,0">
                        <materialDesign:PackIcon Kind="ArrowLeft" Foreground="{Binding ModeTitleBrush}" />
                    </Button>
                    <materialDesign:PackIcon Kind="Delete" Foreground="{Binding ModeTitleBrush}"
                                             Visibility="{Binding IsTrashMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                             Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <materialDesign:PackIcon Kind="Archive" Foreground="{Binding ModeTitleBrush}"
                                             Visibility="{Binding IsArchivedMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                             Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding DisplayModeTitle}" FontWeight="Bold" Foreground="{Binding ModeTitleBrush}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Visibility="{Binding IsCasesMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Button Command="{Binding EditCaseCommand}" Style="{StaticResource ToolIconButtonStyle}" ToolTip="Editar Caso">
                    <materialDesign:PackIcon Kind="SquareEditOutline" Width="25" Height="25" />
                </Button>
                <Button Command="{Binding PrintCaseCommand}" Style="{StaticResource ToolIconButtonStyle}" ToolTip="Imprimir Reporte">
                    <materialDesign:PackIcon Kind="Printer" Width="25" Height="25" />
                </Button>
                <Button Command="{Binding ExportToExcelCommand}" Style="{StaticResource ToolIconButtonStyle}" ToolTip="Exportar a Excel (CSV)">
                    <materialDesign:PackIcon Kind="Download" Width="25" Height="25" />
                </Button>
                <Button Style="{StaticResource ToolIconButtonStyle}" ToolTip="Ordenar casos" Click="SortCasesButton_Click">
                    <materialDesign:PackIcon Kind="SortVariant" Width="25" Height="25" />
                    <Button.ContextMenu>
                        <ContextMenu Placement="Bottom"
                                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="Más recientes primero" Command="{Binding SortByMostRecentCommand}" />
                            <MenuItem Header="Nombre del alumno A-Z" Command="{Binding SortByStudentNameAscendingCommand}" />
                            <MenuItem Header="Nombre del alumno Z-A" Command="{Binding SortByStudentNameDescendingCommand}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Visibility="{Binding IsCalendarMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Button Command="{Binding ShowActiveCasesCommand}" Style="{StaticResource ToolIconButtonStyle}" ToolTip="Volver a Casos Activos">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="20" Height="20" />
                </Button>
            </StackPanel>
        </Grid>
        </Border>

        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource AppCardStyle}" Padding="12" Margin="22,0,22,14"
                Visibility="{Binding IsCasesMode, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="185" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="180" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" ItemsSource="{Binding StatusFilterOptions}" SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}"
                          Height="40" Margin="4" Padding="8,4" ToolTip="Filtrar por estado" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding CategoryFilterOptions}" SelectedItem="{Binding SelectedCategoryFilter, Mode=TwoWay}"
                          Height="40" Margin="4" Padding="8,4" ToolTip="Filtrar por categoría">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource CategoryDisplayConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox Grid.Column="2" ItemsSource="{Binding GradeFilterOptions}" SelectedItem="{Binding SelectedGradeFilter, Mode=TwoWay}"
                          Height="40" Margin="4" Padding="8,4" ToolTip="Filtrar por grado" />
                <Grid Grid.Column="4" Height="40" Margin="4" ToolTip="Filtrar por fecha de actualización">
                    <DatePicker SelectedDate="{Binding SelectedUpdatedDate, Mode=TwoWay}" SelectedDateFormat="Short" Height="40" />
                    <TextBlock Text="Fecha de actualización" Margin="8,0,32,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedUpdatedDate}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>

        <!-- CALENDARIO DE RECORDATORIOS -->
        <Grid Grid.Row="3" Grid.Column="1" Margin="22,0,22,0" Visibility="{Binding IsCalendarMode, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="14" Padding="20" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding PreviousMonthCommand}" Style="{StaticResource MaterialDesignIconButton}" ToolTip="Mes anterior">
                            <materialDesign:PackIcon Kind="ChevronLeft" />
                        </Button>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="PROGRAMADOR" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding DisplayedMonth, StringFormat='{}{0:MMMM yyyy}'}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="2" Command="{Binding NextMonthCommand}" Style="{StaticResource MaterialDesignIconButton}" ToolTip="Mes siguiente">
                            <materialDesign:PackIcon Kind="ChevronRight" />
                        </Button>
                    </Grid>
                    <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,8">
                        <TextBlock Text="DOM" FontWeight="Bold" TextAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="LUN" FontWeight="Bold" TextAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="MAR" FontWeight="Bold" TextAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="MIÉ" FontWeight="Bold" TextAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="JUE" FontWeight="Bold" TextAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="VIE" FontWeight="Bold" TextAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="SÁB" FontWeight="Bold" TextAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                    </UniformGrid>
                        <ItemsControl Grid.Row="2" ItemsSource="{Binding CalendarDays}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="7" Rows="6" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectCalendarDateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="{Binding Background}" Foreground="{Binding Foreground}" BorderBrush="Transparent" BorderThickness="0" Margin="2" Padding="2" ToolTip="{Binding Date, StringFormat='{}{0:d}'}">
                                    <Grid>
                                        <TextBlock Text="{Binding Date.Day}" Foreground="{Binding Foreground}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5" Visibility="{Binding HasReminders, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" CornerRadius="14" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="PROGRAMAR RECORDATORIO" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding SelectedDate, StringFormat='{}{0:dddd, d \\de MMMM \\de yyyy}'}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,18" />
                        <TextBlock Text="{Binding SelectedDateStatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic" Margin="0,0,0,8" />
                        <ListBox ItemsSource="{Binding SelectedDateReminders}" SelectedItem="{Binding SelectedReminder}" MouseDoubleClick="ReminderListBox_MouseDoubleClick" Margin="0,6,0,18" MaxHeight="190" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,3,8,3" Width="180">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="10" Height="10" Fill="{StaticResource SecondaryBrush}" Margin="0,4,10,0" VerticalAlignment="Top" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding ScheduledAt, StringFormat='{}{0:HH:mm}'}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" MaxHeight="34" />
                                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                    <materialDesign:PackIcon Kind="BellOutline" Width="14" Height="14" Margin="0,0,4,0" />
                                                    <TextBlock Text="ACTIVADAS" FontSize="10" FontWeight="Bold" Visibility="{Binding NotificationsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <TextBlock Text="DESACTIVADAS" FontSize="10" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding NotificationsEnabled}" Value="False">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                                <materialDesign:PackIcon Kind="OpenInNew" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                                <Button Command="{Binding DataContext.DeleteReminderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignIconButton}" ToolTip="Eliminar recordatorio" Width="28" Height="28" Padding="0" Foreground="{StaticResource DangerBrush}">
                                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="Título del caso" FontWeight="Bold" />
                        <TextBox Text="{Binding ReminderTitle, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsSelectedDateEditable}" Margin="0,5,0,12" Padding="8" />
                        <TextBlock Text="Hora" FontWeight="Bold" />
                        <materialDesign:TimePicker SelectedTime="{Binding ReminderSelectedTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedTimeChanged="ReminderTimePicker_SelectedTimeChanged" IsEnabled="{Binding IsSelectedDateEditable}" Margin="0,5,0,12" />
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="Activar notificaciones" FontWeight="Bold" VerticalAlignment="Center" />
                            <CheckBox IsChecked="{Binding ReminderNotificationsEnabled}" IsEnabled="{Binding IsSelectedDateEditable}" DockPanel.Dock="Right" />
                        </DockPanel>
                        <TextBlock Text="Descripción" FontWeight="Bold" />
                        <TextBox Text="{Binding ReminderDescription, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsSelectedDateEditable}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" Margin="0,5,0,12" Padding="8" />
                        <TextBlock Text="Repetir después de" FontWeight="Bold" />
                        <ComboBox ItemsSource="{Binding RecurrenceOptions}" SelectedItem="{Binding ReminderRecurrence}" IsEnabled="{Binding IsSelectedDateEditable}" Margin="0,5,0,18" Padding="6" />
                        <TextBlock Text="Finalizar repetición" FontWeight="Bold" />
                        <DatePicker SelectedDate="{Binding ReminderRecurrenceEndDate}" IsEnabled="{Binding IsSelectedDateEditable}" Margin="0,5,0,12" />
                        <TextBlock Text="Anticipación de la notificación" FontWeight="Bold" />
                        <ComboBox ItemsSource="{Binding NotificationAdvanceOptions}" SelectedItem="{Binding ReminderNotificationAdvanceMinutes}" IsEnabled="{Binding IsSelectedDateEditable}" Margin="0,5,0,12" Padding="6">
                            <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding StringFormat={}{0} minutos antes}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="Sonido de notificación" FontWeight="Bold" VerticalAlignment="Center" />
                            <CheckBox IsChecked="{Binding ReminderSoundEnabled}" IsEnabled="{Binding IsSelectedDateEditable}" DockPanel.Dock="Right" />
                        </DockPanel>
                        <WrapPanel HorizontalAlignment="Right">
                            <Button Content="NUEVO" Command="{Binding NewReminderCommand}" IsEnabled="{Binding CanCreateReminder}" Margin="0,0,6,6" Padding="10,7" MinWidth="76" />
                            <Button Content="GUARDAR / EDITAR" Command="{Binding SaveReminderCommand}" IsEnabled="{Binding IsSelectedDateEditable}" Margin="0,0,0,6" Padding="10,7" MinWidth="128" />
                        </WrapPanel>
                        <TextBlock Text="Historial: solo consulta" Visibility="{Binding IsHistoricalDate, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic" Margin="0,14,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- TABLA DE CASOS (DataGrid) -->
        <DataGrid Grid.Row="3" Grid.Column="1" Margin="22,0,22,0" Visibility="{Binding IsCasesMode, Converter={StaticResource BooleanToVisibilityConverter}}" GridLinesVisibility="None" RowHeaderWidth="0" ItemsSource="{Binding Cases}" SelectedItem="{Binding SelectedCase}" MouseDoubleClick="CasesDataGrid_MouseDoubleClick"
                  PreviewMouseLeftButtonDown="CasesDataGrid_PreviewMouseLeftButtonDown"
                  ContextMenuOpening="CasesDataGrid_ContextMenuOpening"
                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                   HorizontalScrollBarVisibility="Auto" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0"
                   RowHeight="62" ColumnHeaderHeight="48" SelectionUnit="FullRow"
                   RowBackground="{StaticResource SurfaceBrush}" AlternatingRowBackground="{StaticResource SurfaceMutedBrush}"
                   materialDesign:DataGridAssist.CornerRadius="14">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                    <Setter Property="BorderBrush" Value="#EDF1F8" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="Background" Value="#D9D9D9" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="Transparent" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="Background" Value="#D9D9D9" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <!-- Menú de Clic Derecho -->
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Editar Caso" Command="{Binding PlacementTarget.DataContext.EditCaseCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                        <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="Pencil" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Imprimir Reporte (PDF)" Command="{Binding PlacementTarget.DataContext.PrintCaseCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                        <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="Printer" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Mandar a la papelera"
                              Visibility="{Binding PlacementTarget.DataContext.IsNotTrashMode, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"
                              Command="{Binding PlacementTarget.DataContext.MoveToTrashCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                        <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="Delete" Foreground="#C62828" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Archivar"
                              Visibility="{Binding PlacementTarget.DataContext.IsActiveMode, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"
                              Command="{Binding PlacementTarget.DataContext.ArchiveCaseCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                        <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="Archive" Foreground="#5D4037" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Desarchivar"
                              Visibility="{Binding PlacementTarget.DataContext.IsArchivedMode, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"
                              Command="{Binding PlacementTarget.DataContext.UnarchiveSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                        <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="ArchiveRemove" Foreground="{DynamicResource PrimaryTextBrush}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Restaurar a Mi Espacio"
                              Visibility="{Binding PlacementTarget.DataContext.IsTrashMode, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"
                              Command="{Binding PlacementTarget.DataContext.RestoreCaseCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                        <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="Restore" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>

            <!-- Columnas -->
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="42">
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Background" Value="#D9D9D9" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTemplateColumn.CellStyle>
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <CheckBox Width="18" Height="18" IsChecked="{Binding DataContext.AreAllVisibleCasesSelected, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWay}"
                                      Command="{Binding DataContext.ToggleSelectAllCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" ToolTip="Seleccionar todos" />
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      ToolTip="Seleccionar caso" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="" Width="35">
                    <DataGridTemplateColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Background" Value="#D9D9D9" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTemplateColumn.CellStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Ellipse Width="13" Height="13" Fill="{Binding AgingBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{Binding AgingTooltip}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="ESTUDIANTE" Binding="{Binding StudentName}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="GRADO" Width="95">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="12" Padding="9,4" HorizontalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource PrimaryDarkBrush}" FontWeight="SemiBold">
                                    <Run Text="{Binding Grade}" />
                                    <Run Text=" - " />
                                    <Run Text="{Binding Group}" />
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="CATEGORÍA" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="#F1EAFE" CornerRadius="12" Padding="9,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Categories, Converter={StaticResource CategoryDisplayConverter}}" Foreground="{StaticResource SecondaryBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="ESTADO" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="12" Padding="9,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#EDF2FF" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="En Proceso">
                                                <Setter Property="Background" Value="#E1F7EF" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Pendiente">
                                                <Setter Property="Background" Value="#E1F7EF" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Finalizado">
                                                <Setter Property="Background" Value="#F1EAFE" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Cancelado">
                                                <Setter Property="Background" Value="#FDEBED" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="ACTUALIZADO" Width="135">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="CalendarClock" Width="16" Height="16" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding UpdatedAt, StringFormat=dd/MM/yyyy}" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="0" Grid.Column="1" Grid.RowSpan="4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,48,22,0"
                    Panel.ZIndex="10"
                    Visibility="{Binding IsNotificationPanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Polygon Points="0,9 9,0 18,9" Fill="White" Stroke="#DCE3E8" StrokeThickness="1" HorizontalAlignment="Right" Margin="0,0,20,-1" Panel.ZIndex="1" />
            <Border Background="White" BorderBrush="#DCE3E8" BorderThickness="1" CornerRadius="12" Padding="0"
                    Width="380" MaxWidth="{Binding ActualWidth, ElementName=WorkspaceViewControl}" MaxHeight="520"
                    Effect="{DynamicResource MaterialDesignShadowDepth2}">
                <Border.RenderTransform>
                    <ScaleTransform ScaleY="0.96" />
                </Border.RenderTransform>
                <Border.RenderTransformOrigin>1,0</Border.RenderTransformOrigin>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.16" />
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" From="0.96" To="1" Duration="0:0:0.16" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="16,14,10,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Notificaciones" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding UnreadNotificationCount, StringFormat={}{0} sin leer}"
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding MarkAllNotificationsAsReadCommand}" Style="{StaticResource MaterialDesignIconButton}"
                                    ToolTip="Marcar todas como leídas" Width="32" Height="32" Padding="5">
                                <materialDesign:PackIcon Kind="EyeCheckOutline" Width="19" Height="19" />
                            </Button>
                            <Button Command="{Binding DeleteAllNotificationsCommand}" Style="{StaticResource MaterialDesignIconButton}"
                                    ToolTip="Borrar todas" Width="32" Height="32" Padding="5">
                                <materialDesign:PackIcon Kind="DeleteSweepOutline" Width="19" Height="19" />
                            </Button>
                            <Button Command="{Binding CloseNotificationsCommand}" Style="{StaticResource MaterialDesignIconButton}"
                                    ToolTip="Cerrar notificaciones" Width="32" Height="32" Padding="5">
                                <materialDesign:PackIcon Kind="Close" Width="19" Height="19" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" BorderBrush="#EEF2F4" BorderThickness="0,1,0,0" Padding="10,10,10,4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="430">
                            <ItemsControl ItemsSource="{Binding Notifications}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#E8EDF0" BorderThickness="0,0,0,1" CornerRadius="8"
                                                Padding="10" Margin="0,0,0,8">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#F7FAFC" />
                                                    <Setter Property="Opacity" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRead}" Value="True">
                                                            <Setter Property="Background" Value="White" />
                                                            <Setter Property="Opacity" Value="0.72" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                                  Command="{Binding DataContext.OpenNotificationSourceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                  CommandParameter="{Binding}" />
                                                </Grid.InputBindings>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="9" Height="9" Fill="{Binding ColorBrush}" Margin="0,4,9,0" VerticalAlignment="Top">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRead}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Details}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                               Margin="0,5,0,0" TextWrapping="Wrap" />
                                                    <TextBlock Text="Abrir origen" FontSize="10" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,7,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="6,0,0,0">
                                                    <Button Command="{Binding DataContext.MarkNotificationAsReadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" Style="{StaticResource MaterialDesignIconButton}" Width="28" Height="28" Padding="4"
                                                            ToolTip="Marcar como leída">
                                                        <materialDesign:PackIcon Kind="EyeOutline" Width="16" Height="16" />
                                                    </Button>
                                                    <Button Command="{Binding DataContext.DeleteNotificationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" Style="{StaticResource MaterialDesignIconButton}" Width="28" Height="28" Padding="4"
                                                            ToolTip="Eliminar notificación">
                                                        <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ACCIONES INFERIORES -->
        <Border Grid.Row="4" Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="12,8" Margin="22,14,22,18">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,14,0">
                <Border Width="27" Height="27" CornerRadius="14" Background="{DynamicResource PrimaryBrush}" Margin="0,0,8,0">
                    <TextBlock Text="✓" Foreground="White" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding SelectedCasesText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>

            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Command="{Binding AddCaseCommand}" Style="{StaticResource PrimaryActionButton}" MinWidth="142" MinHeight="40" Margin="4">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="Nuevo Caso" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <StackPanel Orientation="Horizontal" Margin="4,0" Visibility="{Binding ShowStatusActions, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button Command="{Binding DeleteSelectedCommand}" IsEnabled="{Binding HasSelectedCases}" Foreground="{StaticResource DangerBrush}"
                            Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#F4D3D8" Background="White" Margin="4">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="DeleteOutline" Margin="0,0,6,0" /><TextBlock Text="Eliminar caso" /></StackPanel>
                    </Button>
                    <Button Command="{Binding MarkFinalizedCommand}" IsEnabled="{Binding CanChangeStatus}" Foreground="{DynamicResource PrimaryTextBrush}"
                            Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="{StaticResource BorderBrush}" Background="White" Margin="4">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="✓" FontWeight="Bold" Margin="0,0,6,0" /><TextBlock Text="Finalizar" /></StackPanel>
                    </Button>
                    <Button Command="{Binding MarkCancelledCommand}" IsEnabled="{Binding CanChangeStatus}" Foreground="{DynamicResource PrimaryTextBrush}"
                            Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceBrush}" Margin="4">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="⊘" FontWeight="Bold" Margin="0,0,6,0" /><TextBlock Text="Cancelar casos" /></StackPanel>
                    </Button>
                </StackPanel>

                <Button Command="{Binding ReopenSelectedCommand}"
                        Visibility="{Binding ShowReopenAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Content="REABRIR CASO" Foreground="{StaticResource SecondaryBrush}"
                        Style="{StaticResource MaterialDesignFlatButton}" Margin="8,4" />

                <StackPanel Orientation="Horizontal" Margin="4,0" Visibility="{Binding ShowArchivedAction, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button Command="{Binding UnarchiveSelectedCommand}" IsEnabled="{Binding HasSelectedCases}"
                            Content="DESARCHIVAR" Foreground="{DynamicResource PrimaryTextBrush}"
                            Style="{StaticResource MaterialDesignFlatButton}" Margin="5,4" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="4,0" Visibility="{Binding IsTrashMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button Command="{Binding RestoreSelectedCommand}" IsEnabled="{Binding HasSelectedCases}"
                            Content="RESTABLECER CASO" Foreground="{StaticResource DangerBrush}"
                            Style="{StaticResource MaterialDesignFlatButton}" Margin="5,4" />
                    <Button Command="{Binding HardDeleteCaseCommand}" Content="BORRAR DEFINITIVAMENTE"
                            Foreground="{StaticResource DangerBrush}" Style="{StaticResource MaterialDesignFlatButton}" Margin="5,4" />
                </StackPanel>
            </WrapPanel>
        </Grid>
        </Border>
    </Grid>
</UserControl>