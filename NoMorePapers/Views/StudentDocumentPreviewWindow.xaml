<Window x:Class="NoMorePapers.Views.StudentDocumentPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Documento del estudiante"
        Width="900" Height="680" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="#F0E6FF" FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="DocumentNameText" FontSize="20" FontWeight="Bold" Foreground="#24133F" Margin="0,0,0,16" TextTrimming="CharacterEllipsis" />
        <Border Grid.Row="1" Background="#FBF9FF" CornerRadius="14" Padding="12">
            <Grid>
                <ScrollViewer x:Name="ImageScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <Image x:Name="DocumentImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </ScrollViewer>
                <wv2:WebView2 x:Name="DocumentWebView" Visibility="Collapsed" />
                <TextBlock x:Name="PreviewMessageText" Text="Cargando previsualización..."
                           Foreground="#6C5689" FontSize="16" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" Margin="24" />
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Zoom" Foreground="#6C5689" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Slider x:Name="ZoomSlider" Minimum="0.25" Maximum="3" Value="1" Width="180" IsEnabled="False"
                        ValueChanged="ZoomSlider_ValueChanged" />
            </StackPanel>
            <Button Grid.Column="1" Content="ABRIR DOCUMENTO" Style="{StaticResource SecondaryActionButton}"
                    Margin="8,0" Click="OpenWithWindows_Click" />
            <Button Grid.Column="2" Content="CERRAR" Style="{StaticResource PrimaryActionButton}"
                    Margin="8,0,0,0" Click="Close_Click" />
        </Grid>
    </Grid>
</Window>
