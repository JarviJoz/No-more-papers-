<UserControl x:Class="NoMorePapers.Views.ProfileSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{StaticResource AppBackgroundBrush}">
    <UserControl.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#2783E8" />
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#176CC8" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BorderBrush" Color="#E2EAF4" />

        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardSelectButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder" Background="White" BorderBrush="#E3EAF4"
                                BorderThickness="1" CornerRadius="16" Padding="20">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.07" Color="#59708C" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#8BBEFF" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsMenuOpen}" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#4C9BFF" />
                                <Setter TargetName="CardBorder" Property="BorderThickness" Value="2" />
                                <Setter TargetName="CardBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.13" Color="#4487D3" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentDarkBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentDarkBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="QuietButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}" />
        </Style>
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Background" Value="#FFF5F4" />
            <Setter Property="Foreground" Value="#B4473F" />
            <Setter Property="BorderBrush" Value="#F0D4D0" />
        </Style>

        <Style x:Key="PasswordPanelStyle" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding PasswordHash}" Value="{x:Static sys:String.Empty}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PasswordHash}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RecoveryPanelStyle" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsRecoveryOpen, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid ClipToBounds="True" Background="{StaticResource AppBackgroundBrush}">
        <Ellipse Width="520" Height="260" Fill="#EAF2FC" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-250,-145,0,0" IsHitTestVisible="False" />
        <Ellipse Width="560" Height="250" Fill="#E9F1FB" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-260,0,0,-145" IsHitTestVisible="False" />
        <Ellipse Width="540" Height="280" Fill="#EAF3FC" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-260,-150" IsHitTestVisible="False" />
        <Canvas Width="170" Height="220" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,14" IsHitTestVisible="False" Opacity="0.55">
            <Path Data="M 92,207 C 91,152 75,96 52,36" Stroke="#5AAFA9" StrokeThickness="4" />
            <Path Data="M 71,91 C 34,84 19,61 16,39 C 48,40 69,56 78,82 Z" Fill="#58B4AC" />
            <Path Data="M 77,119 C 105,87 132,86 154,94 C 138,119 111,131 81,130 Z" Fill="#69BCB3" />
            <Path Data="M 82,153 C 45,151 25,132 17,109 C 50,106 74,119 88,145 Z" Fill="#73C2B8" />
            <Path Data="M 91,174 C 109,143 134,135 158,140 C 147,168 123,183 94,185 Z" Fill="#58ADA7" />
        </Canvas>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="32,22" MaxWidth="1040" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,4,0,26">
                    <Grid Width="58" Height="58" HorizontalAlignment="Center" Margin="0,0,0,8">
                        <materialDesign:PackIcon Kind="FileDocumentOutline" Width="52" Height="52" Foreground="#24769A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <materialDesign:PackIcon Kind="Leaf" Width="25" Height="25" Foreground="#4DBCB1" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                    </Grid>
                    <TextBlock Text="No More Papers" FontSize="30" FontWeight="Bold" Foreground="#17385D" HorizontalAlignment="Center" />
                    <TextBlock Text="Orientación escolar, ahora digital." FontSize="17" FontWeight="SemiBold" Foreground="#627895" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    <TextBlock Text="Menos papel. Más organización." FontSize="14" Foreground="#7587A0" HorizontalAlignment="Center" Margin="0,3,0,0" />
                    <Border Width="48" Height="2" Background="#53C4BD" CornerRadius="1" HorizontalAlignment="Center" Margin="0,19,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,24">
                    <TextBlock Text="Selecciona tu perfil" FontSize="24" FontWeight="Bold" Foreground="#17385D" HorizontalAlignment="Center" />
                    <TextBlock Text="Elige el perfil con el que deseas ingresar a la aplicación." FontSize="14" Foreground="#667B98" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,5,0,0" />
                </StackPanel>

                <ItemsControl Grid.Row="2" ItemsSource="{Binding Profiles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="8,0">
                                <Button Style="{StaticResource CardSelectButtonStyle}"
                                        Command="{Binding DataContext.SelectProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" MinHeight="236">
                                    <Grid MinHeight="194">
                                        <StackPanel VerticalAlignment="Center" Margin="0,8,0,0">
                                        <Grid Width="70" Height="70" HorizontalAlignment="Center" Margin="0,0,0,15">
                                            <Border CornerRadius="35">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#E5EFFB" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConfigured}" Value="False">
                                                                <Setter Property="Background" Value="Transparent" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <Ellipse Stroke="#B7C9E1" StrokeThickness="1.5" StrokeDashArray="3,3">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConfigured}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <materialDesign:PackIcon Kind="AccountCircle" Width="47" Height="47" Foreground="#4383C6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConfigured}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                            <TextBlock Text="+" FontSize="35" FontWeight="Light" Foreground="#8FA4BD" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConfigured}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#23476E" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding Name}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsConfigured}" Value="False">
                                                            <Setter Property="Text" Value="{Binding SlotNumber, StringFormat='SLOT {0} / vacío'}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock FontSize="12" Foreground="#71839B" HorizontalAlignment="Center" Margin="0,4,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Orientador escolar" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsConfigured}" Value="False">
                                                            <Setter Property="Text" Value="Crear perfil" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Border CornerRadius="9" Padding="12,9" Margin="0,20,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsConfigured}" Value="False">
                                                            <Setter Property="Background" Value="#EDF3FA" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Entrar  →" />
                                                        <Setter Property="Foreground" Value="White" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConfigured}" Value="False">
                                                                <Setter Property="Text" Value="Crear  →" />
                                                                <Setter Property="Foreground" Value="#71839B" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        </StackPanel>
                                        <Border Background="#E5F8F3" CornerRadius="12" Padding="9,3" HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsConfigured}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="● Activo" FontSize="11" FontWeight="SemiBold" Foreground="#14966D" />
                                        </Border>
                                    </Grid>
                                </Button>

                                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,10,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMenuOpen}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.06" Color="#59708C" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <StackPanel Style="{StaticResource PasswordPanelStyle}">
                                            <Grid>
                                                <PasswordBox x:Name="ProfilePasswordBox" PasswordChanged="ProfilePasswordChanged" Height="40" Padding="10,0,42,0">
                                                    <PasswordBox.Style>
                                                        <Style TargetType="PasswordBox">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.IsPasswordVisible, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </PasswordBox.Style>
                                                </PasswordBox>
                                                <TextBox Text="{Binding DataContext.PasswordInput, RelativeSource={RelativeSource AncestorType=ItemsControl}, UpdateSourceTrigger=PropertyChanged}"
                                                         Height="40" Padding="10,0,42,0">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.IsPasswordVisible, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                                <Button Style="{StaticResource QuietButtonStyle}"
                                                        Command="{Binding DataContext.TogglePasswordVisibilityCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        Width="38" HorizontalAlignment="Right" Background="Transparent">
                                                    <materialDesign:PackIcon Kind="Eye" />
                                                </Button>
                                            </Grid>
                                            <Button Style="{StaticResource QuietButtonStyle}" Content="Olvidé mi contraseña" Command="{Binding DataContext.ToggleRecoveryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    HorizontalAlignment="Left" Padding="4,6" />
                                            <StackPanel Style="{StaticResource RecoveryPanelStyle}">
                                                <DatePicker SelectedDate="{Binding DataContext.RecoveryBirthDate, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Margin="0,4,0,8" />
                                                <TextBox Text="{Binding DataContext.NewPassword, RelativeSource={RelativeSource AncestorType=ItemsControl}, UpdateSourceTrigger=PropertyChanged}"
                                                         materialDesign:HintAssist.Hint="Nueva contraseña" Margin="0,0,0,8" />
                                                <Button Style="{StaticResource PrimaryButtonStyle}" Content="GUARDAR NUEVA CONTRASEÑA" Command="{Binding DataContext.ResetPasswordCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                            <Button Style="{StaticResource DangerButtonStyle}" Content="Borrar perfil" Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" Margin="0,0,8,0" />
                                            <Button Style="{StaticResource PrimaryButtonStyle}" Content="Acceder" Command="{Binding DataContext.AccessProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" Padding="14,7" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,32,0,4" IsHitTestVisible="False">
                    <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="17" Height="17" Foreground="#9AADC5" Margin="0,0,7,0" />
                    <TextBlock Text="Tu información está segura con nosotros" FontSize="11" Foreground="#9AADC5" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>

</UserControl>