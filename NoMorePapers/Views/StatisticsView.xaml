<UserControl x:Class="NoMorePapers.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{StaticResource AppBackgroundBrush}">

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,30">
            <Button Command="{Binding GoBackCommand}" Style="{StaticResource MaterialDesignFloatingActionMiniButton}" Background="{DynamicResource PrimaryBrush}" BorderThickness="0" Margin="0,0,20,0" Foreground="{DynamicResource PrimaryForegroundBrush}">
                <materialDesign:PackIcon Kind="ChevronLeft" />
            </Button>
            <TextBlock Text="DASHBOARD DE RENDIMIENTO" FontSize="28" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
        </StackPanel>

        <!-- Tarjetas de Estadísticas -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Resumen Global -->
            <StackPanel Grid.Column="0" Margin="10">
                <TextBlock Text="RESUMEN GLOBAL" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,15"/>

                <Border Style="{StaticResource AppCardStyle}" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="TOTAL DE CASOS ATENDIDOS" Foreground="Gray"/>
                        <TextBlock Text="{Binding TotalCases}" FontSize="36" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource AppCardStyle}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="EN PROCESO" Foreground="Gray"/>
                            <TextBlock Text="{Binding ActiveCasesCount}" FontSize="28" FontWeight="Bold" Foreground="#FF9800"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource AppCardStyle}" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="TERMINADOS" Foreground="Gray"/>
                            <TextBlock Text="{Binding FinishedCasesCount}" FontSize="28" FontWeight="Bold" Foreground="#4CAF50"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Background="#FFEBEE" CornerRadius="10" Padding="20" Margin="0,15,0,0">
                    <StackPanel>
                        <TextBlock Text="CASOS CRÍTICOS (Sin actualizar > 30 días)" Foreground="#D32F2F" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding CriticalCasesCount}" FontSize="28" FontWeight="Bold" Foreground="#D32F2F"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Resumen por Categorías -->
            <StackPanel Grid.Column="1" Margin="10">
                <TextBlock Text="INCIDENCIA POR CATEGORÍAS" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,15"/>

                <Border Style="{StaticResource AppCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,10">
                            <TextBlock Text="Problemas Emocionales" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding EmocionalCount}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="18"/>
                        </Grid>
                        <Separator/>
                        <Grid Margin="0,10">
                            <TextBlock Text="Dificultades Académicas" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding AcademicoCount}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="18"/>
                        </Grid>
                        <Separator/>
                        <Grid Margin="0,10">
                            <TextBlock Text="Conflictos Familiares" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding FamiliarCount}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="18"/>
                        </Grid>
                        <Separator/>
                        <Grid Margin="0,10">
                            <TextBlock Text="Problemas Conductuales" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ConductualCount}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="18"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>