<Window x:Class="NoMorePapers.Views.ContactWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Contactar" Width="640" Height="760" MinWidth="500" MinHeight="540"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="26">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="5" Opacity="0.22" Color="#18294A" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="13" Background="{DynamicResource SurfaceMutedBrush}">
                    <materialDesign:PackIcon Kind="EmailOutline" Width="23" Height="23" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="¿Tienes una idea o inquietud?" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="Tu opinión nos ayuda a mejorar No More Papers." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="2" Width="38" Height="38" Style="{StaticResource MaterialDesignIconButton}" ToolTip="Cerrar" AutomationProperties.Name="Cerrar formulario de contacto" Click="Close_Click">
                    <materialDesign:PackIcon Kind="Close" />
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="FormPanel">
                    <TextBlock Text="Si tienes ideas para nuevos cambios, mejoras, inquietudes, sugerencias o deseas reportar algún problema, puedes enviarnos un mensaje. Tu opinión nos ayuda a seguir mejorando No More Papers."
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,18" />
                    <TextBlock Text="Nombre" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                    <TextBox x:Name="NameInput" MinHeight="42" Padding="10" MaxLength="100" TextChanged="Input_TextChanged" AutomationProperties.Name="Nombre" />
                    <TextBlock x:Name="NameError" Foreground="{StaticResource DangerBrush}" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,3,0,8" />

                    <TextBlock Text="Correo electrónico" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,6" />
                    <TextBox x:Name="EmailInput" MinHeight="42" Padding="10" MaxLength="254" TextChanged="Input_TextChanged" AutomationProperties.Name="Correo electrónico" />
                    <TextBlock x:Name="EmailError" Foreground="{StaticResource DangerBrush}" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,3,0,8" />

                    <TextBlock Text="Asunto" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,6" />
                    <TextBox x:Name="SubjectInput" MinHeight="42" Padding="10" MaxLength="200" TextChanged="Input_TextChanged" AutomationProperties.Name="Asunto" />
                    <TextBlock x:Name="SubjectError" Foreground="{StaticResource DangerBrush}" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,3,0,8" />

                    <TextBlock Text="Mensaje" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,6" />
                    <TextBox x:Name="MessageInput" MinHeight="125" Padding="10" MaxLength="5000" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="Input_TextChanged" AutomationProperties.Name="Mensaje" />
                    <TextBlock x:Name="MessageError" Foreground="{StaticResource DangerBrush}" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,3,0,8" />
                    <TextBlock x:Name="FormStatus" Foreground="{StaticResource DangerBrush}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,8,0,0" AutomationProperties.LiveSetting="Assertive" />
                </StackPanel>
            </ScrollViewer>

            <Border x:Name="SuccessPanel" Grid.Row="1" Style="{StaticResource AppCardStyle}" Visibility="Collapsed" VerticalAlignment="Center" Margin="12">
                <StackPanel HorizontalAlignment="Center" MaxWidth="420">
                    <materialDesign:PackIcon Kind="CheckCircleOutline" Width="54" Height="54" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" Margin="0,0,0,14" />
                    <TextBlock Text="¡Mensaje enviado correctamente!" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Text="Gracias por ayudarnos a mejorar No More Papers." Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <ProgressBar x:Name="SendingIndicator" Width="72" Height="5" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,14,0" />
                <Button x:Name="CancelButton" Content="Cancelar" Style="{StaticResource SecondaryActionButton}" Margin="0,0,8,0" Click="Close_Click" />
                <Button x:Name="SendButton" Style="{StaticResource PrimaryActionButton}" Click="Send_Click" AutomationProperties.Name="Enviar mensaje">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Send" Width="17" Height="17" Margin="0,0,7,0" />
                        <TextBlock x:Name="SendButtonText" Text="Enviar mensaje" />
                    </StackPanel>
                </Button>
                <Button x:Name="DoneButton" Content="Cerrar" Style="{StaticResource PrimaryActionButton}" Visibility="Collapsed" Click="Close_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>