<Application x:Class="NoMorePapers.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:presentationOptions="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="Blue" SecondaryColor="DeepPurple" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F7FC" presentationOptions:Freeze="False" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" presentationOptions:Freeze="False" />
            <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#F2F5FC" presentationOptions:Freeze="False" />
            <SolidColorBrush x:Key="PrimaryBrush" Color="#315BFA" presentationOptions:Freeze="False" />
            <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#294CDA" presentationOptions:Freeze="False" />
            <SolidColorBrush x:Key="PrimaryHoverForegroundBrush" Color="#FFFFFF" presentationOptions:Freeze="False" />
            <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#2442B8" presentationOptions:Freeze="False" />
            <SolidColorBrush x:Key="PrimaryPressedForegroundBrush" Color="#FFFFFF" presentationOptions:Freeze="False" />
            <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="#FFFFFF" presentationOptions:Freeze="False" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#294CDA" presentationOptions:Freeze="False" />
            <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#1B2E62" presentationOptions:Freeze="False" />
            <SolidColorBrush x:Key="SecondaryBrush" Color="#8754E8" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#14966D" />
            <SolidColorBrush x:Key="SidebarBrush" Color="#172B58" presentationOptions:Freeze="False" />
            <SolidColorBrush x:Key="SidebarHoverBrush" Color="#263F78" presentationOptions:Freeze="False" />
            <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#314F91" presentationOptions:Freeze="False" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#17264A" presentationOptions:Freeze="False" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#68799F" presentationOptions:Freeze="False" />
            <SolidColorBrush x:Key="BorderBrush" Color="#E3EAF7" presentationOptions:Freeze="False" />
            <SolidColorBrush x:Key="DangerBrush" Color="#E5485B" />

            <Style x:Key="AppCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="20" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="22" ShadowDepth="2" Opacity="0.055" Color="#263C6B" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SidebarButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                <Setter Property="Foreground" Value="#F3F4F6" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="Margin" Value="0,3" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
                        <Setter Property="Foreground" Value="White" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
                        <Setter Property="Foreground" Value="White" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.48" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ToolIconButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="MinWidth" Value="44" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="Margin" Value="3" />
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.06" Color="#263C6B" />
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource PrimaryPressedBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryPressedForegroundBrush}" />
                        <Setter Property="Effect" Value="{x:Null}" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.48" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
                <Setter Property="MinWidth" Value="120" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="18,5" />
                <Setter Property="Margin" Value="0,4" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.12" Color="#263C6B" />
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryHoverForegroundBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHoverBrush}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource PrimaryPressedBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryPressedBrush}" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryPressedBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SecondaryActionButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}" />
                <Setter Property="Padding" Value="20,10" />
                <Setter Property="Margin" Value="0,4" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>

            <Style x:Key="CaptionStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                <Setter Property="FontSize" Value="13" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>